// Julia REPL adapter for the Wonder Room language atlas.
// Repository: browser-weather. This module is intentionally independent of the browser UI.
module Julia_REPL_WonderAdapter
const project = "browser-weather"
const language = "Julia REPL"
const purpose = "preserve the exhibit while expanding its polyglot archive"
function describe() = project + " / " + language + " / " + purpose
end
